#cloud-config
autoinstall:
  version: 1

  locale: fr_FR.UTF-8
  keyboard:
    layout: fr

  identity:
    hostname: ubuntu-laptop
    username: ubuntu-admin
    password: "$6$/yanqE2Vz2S8vxoc$9AijXrulDxDWtdbzSRcFUGvQgoccp7jn3HYYx3l4n3MHeZZnrpgQuMuibotuTLc87L2/l0jTpEicShq5bvLOE0"

  ssh:
    install-server: true
    allow-pw: true

  early-commands:
    # Proxy (si 172.30/172.31)
    - bash /cdrom/NOLOUD/prepare-proxy.sh || true

    # Keyfiles LUKS temporaires (disponibles pendant l'install)
    - mkdir -p /run/crypt
    - umask 077
    - openssl rand -out /run/crypt/root.key 64
    - openssl rand -out /run/crypt/swap.key 64

  packages:
    - btrfs-progs
    - cryptsetup
    - tpm2-tools
    - rsync
    - network-manager
    - network-manager-openconnect
    - iwd
    - btop
    - curl
    - git
    - wget
    - net-tools
    - ansible

  storage:
    config:
  
      - type: disk
        id: disk0
        path: /dev/nvme0n1
        ptable: gpt
        wipe: superblock-recursive
  
      - type: partition
        id: efi-part
        device: disk0
        size: 512M
        flag: esp
        grub_device: true
  
      - type: format
        id: efi-fs
        volume: efi-part
        fstype: fat32
  
      - type: mount
        id: mount-efi
        device: efi-fs
        path: /boot/efi
  
      - type: partition
        id: root-part
        device: disk0
        size: -1
  
      - type: format
        id: root-fs
        volume: root-part
        fstype: ext4
  
      - type: mount
        id: mount-root
        device: root-fs
        path: /

  late-commands:
    # Proxy autoswitch dans l'OS installé
    - curtin in-target -- bash /cdrom/NOLOUD/install-proxy-autoswitch.sh || true

    # Rendre la clé swap persistante (hibernation) + crypttab/initramfs
    - curtin in-target -- bash -lc '
        set -e
        install -d -m 0700 /etc/cryptsetup-keys.d
        install -m 0400 /run/crypt/swap.key /etc/cryptsetup-keys.d/cryptswap.key
        SWAP_UUID="$(blkid -s UUID -o value /dev/nvme0n1p2)"
        grep -q "^cryptswap " /etc/crypttab || echo "cryptswap UUID=${SWAP_UUID} /etc/cryptsetup-keys.d/cryptswap.key luks,discard" >> /etc/crypttab
        install -d -m 0755 /etc/cryptsetup-initramfs
        echo "KEYFILE_PATTERN=/etc/cryptsetup-keys.d/*.key" > /etc/cryptsetup-initramfs/conf-hook
        echo "RESUME=/dev/mapper/cryptswap" > /etc/initramfs-tools/conf.d/resume
        update-initramfs -u
      '

    # Rendre la clé root persistante (pour déverrouillage sans /run/crypt après reboot)
    - curtin in-target -- bash -lc '
        set -e
        install -d -m 0700 /etc/cryptsetup-keys.d
        install -m 0400 /run/crypt/root.key /etc/cryptsetup-keys.d/cryptroot.key
        ROOT_UUID="$(blkid -s UUID -o value /dev/nvme0n1p3)"
        grep -q "^cryptroot " /etc/crypttab || echo "cryptroot UUID=${ROOT_UUID} /etc/cryptsetup-keys.d/cryptroot.key luks,discard" >> /etc/crypttab
        install -d -m 0755 /etc/cryptsetup-initramfs
        echo "KEYFILE_PATTERN=/etc/cryptsetup-keys.d/*.key" > /etc/cryptsetup-initramfs/conf-hook
        update-initramfs -u
      '

    # Créer les subvolumes btrfs (top-level) + réinstaller fstab cohérent
    - curtin in-target -- bash -lc '
        set -e
        mkdir -p /mnt/btrfs-top
        mount -o subvolid=5 /dev/mapper/cryptroot /mnt/btrfs-top
        for sv in @ @home @var @snapshots; do
          btrfs subvolume show "/mnt/btrfs-top/$sv" >/dev/null 2>&1 || btrfs subvolume create "/mnt/btrfs-top/$sv"
        done
        umount /mnt/btrfs-top
      '

    # Recovery key root (ajoute une clé de secours fichier)
    - curtin in-target -- bash -lc '
        set -e
        install -d -m 0700 /root/recovery
        umask 077
        openssl rand -out /root/recovery/luks-root-recovery.key 32
        cryptsetup luksAddKey /dev/nvme0n1p3 /root/recovery/luks-root-recovery.key --key-file /etc/cryptsetup-keys.d/cryptroot.key || true
      '

    # TPM enroll root (best effort)
    - curtin in-target -- bash -lc '
        systemd-cryptenroll --tpm2-device=auto /dev/nvme0n1p3 || true
      '

    # NetworkManager + iwd
    - rm -f /target/etc/netplan/*.yaml
    - "echo 'network:\\n  version: 2\\n  renderer: NetworkManager' > /target/etc/netplan/01-nm.yaml"
    - chmod 600 /target/etc/netplan/01-nm.yaml

    - curtin in-target -- systemctl enable iwd
    - curtin in-target -- systemctl enable NetworkManager

    - mkdir -p /target/etc/NetworkManager/conf.d
    - "echo '[device]\\nwifi.backend=iwd' > /target/etc/NetworkManager/conf.d/wifi-backend.conf"

    - curtin in-target -- systemctl disable systemd-networkd || true
    - curtin in-target -- systemctl mask systemd-networkd || true
    - curtin in-target -- systemctl disable wpa_supplicant || true
    - curtin in-target -- systemctl mask wpa_supplicant || true
