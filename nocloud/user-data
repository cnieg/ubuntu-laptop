#cloud-config
autoinstall:
  version: 1

  locale: fr_FR.UTF-8
  keyboard:
    layout: fr

  identity:
    hostname: ubuntu-laptop
    username: ubuntu-admin
    password: "$6$/yanqE2Vz2S8vxoc$9AijXrulDxDWtdbzSRcFUGvQgoccp7jn3HYYx3l4n3MHeZZnrpgQuMuibotuTLc87L2/l0jTpEicShq5bvLOE0"

  ssh:
    install-server: true
    allow-pw: true

  packages:
    - btrfs-progs
    - cryptsetup
    - tpm2-tools
    - rsync
    - network-manager
    - network-manager-openconnect
    - iwd
    - btop
    - curl
    - git
    - wget
    - net-tools
    - ansible

  early-commands:
    - mkdir -p /run/crypt
    - umask 077
    - openssl rand -out /run/crypt/root.key 64
    - openssl rand -out /run/crypt/swap.key 64

    - bash /cdrom/NOLOUD/prepare-proxy.sh

    - |
      set -e
      export DEBIAN_FRONTEND=noninteractive
      apt-get update
      apt-get install -y --no-install-recommends btrfs-progs cryptsetup parted util-linux dosfstools

    # Phase 1: crée p2/p3 + luks + btrfs subvols (NE crée PAS l'ESP)
    - bash /cdrom/NOLOUD/prepare-disk.sh

  storage:
    config:
      # Le disque est géré par Subiquity pour l'ESP (p1) + grub
      - type: disk
        id: disk0
        path: /dev/nvme0n1
        grub_device: true

      # ESP créée par Subiquity => pas de number, pas de preserve
      - type: partition
        id: efi-part
        device: disk0
        size: 512M
        flag: boot

      - type: format
        id: efi-fs
        volume: efi-part
        fstype: fat32

      - type: mount
        id: mount-efi
        device: efi-fs
        path: /boot/efi

      # SWAP créée par phase 1 => number + preserve
      - type: partition
        id: swap-part
        device: disk0
        number: 2
        preserve: true

      - type: dm_crypt
        id: cryptswap
        dm_name: cryptswap
        volume: swap-part
        keyfile: /run/crypt/swap.key
        preserve: true

      - type: format
        id: swap-fs
        volume: cryptswap
        fstype: swap
        preserve: true

      - type: mount
        id: mount-swap
        device: swap-fs
        path: none

      # ROOT créée par phase 1 => number + preserve
      - type: partition
        id: root-part
        device: disk0
        number: 3
        preserve: true

      - type: dm_crypt
        id: cryptroot
        dm_name: cryptroot
        volume: root-part
        keyfile: /run/crypt/root.key
        preserve: true

      - type: format
        id: root-btrfs
        volume: cryptroot
        fstype: btrfs
        preserve: true

      - type: mount
        id: mount-root
        device: root-btrfs
        path: /
        options: "subvol=@,compress=zstd,noatime,ssd,space_cache=v2"

      - type: mount
        id: mount-home
        device: root-btrfs
        path: /home
        options: "subvol=@home,compress=zstd,noatime,ssd,space_cache=v2"

      - type: mount
        id: mount-var
        device: root-btrfs
        path: /var
        options: "subvol=@var,compress=zstd,noatime,ssd,space_cache=v2"

      - type: mount
        id: mount-snapshots
        device: root-btrfs
        path: /.snapshots
        options: "subvol=@snapshots,compress=zstd,noatime,ssd,space_cache=v2"

  late-commands:
    # Proxy nomade
    - curtin in-target -- bash /cdrom/NOLOUD/install-proxy-autoswitch.sh

    # Clé persistante pour cryptswap + initramfs (hibernation)
    - curtin in-target -- bash -lc '
        set -e
        install -d -m 0700 /etc/cryptsetup-keys.d
        install -m 0400 /run/crypt/swap.key /etc/cryptsetup-keys.d/cryptswap.key
        SWAP_UUID="$(blkid -s UUID -o value /dev/nvme0n1p2)"
        grep -q "^cryptswap " /etc/crypttab || echo "cryptswap UUID=${SWAP_UUID} /etc/cryptsetup-keys.d/cryptswap.key luks" >> /etc/crypttab
        install -d -m 0755 /etc/cryptsetup-initramfs
        echo "KEYFILE_PATTERN=/etc/cryptsetup-keys.d/*.key" > /etc/cryptsetup-initramfs/conf-hook
        update-initramfs -u
      '

    - curtin in-target -- bash -lc 'echo "RESUME=/dev/mapper/cryptswap" > /etc/initramfs-tools/conf.d/resume && update-initramfs -u'

    # Recovery key root
    - bash -lc 'install -d -m 0700 /target/root/recovery && umask 077 && openssl rand -out /target/root/recovery/luks-root-recovery.key 32 && cryptsetup luksAddKey /dev/nvme0n1p3 /target/root/recovery/luks-root-recovery.key --key-file /run/crypt/root.key'

    # TPM auto-unlock root (best effort)
    - curtin in-target -- bash -lc 'apt-get update && apt-get install -y tpm2-tools && systemd-cryptenroll --tpm2-device=auto /dev/nvme0n1p3 || true'

    # NetworkManager + iwd backend
    - rm -f /target/etc/netplan/*.yaml
    - "echo 'network:\\n  version: 2\\n  renderer: NetworkManager' > /target/etc/netplan/01-nm.yaml"
    - chmod 600 /target/etc/netplan/01-nm.yaml

    - curtin in-target -- systemctl enable iwd
    - curtin in-target -- systemctl enable NetworkManager

    - mkdir -p /target/etc/NetworkManager/conf.d
    - "echo '[device]\\nwifi.backend=iwd' > /target/etc/NetworkManager/conf.d/wifi-backend.conf"

    - curtin in-target -- systemctl disable systemd-networkd
    - curtin in-target -- systemctl mask systemd-networkd
    - curtin in-target -- systemctl disable wpa_supplicant
    - curtin in-target -- systemctl mask wpa_supplicant
    