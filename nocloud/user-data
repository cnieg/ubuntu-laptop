#cloud-config
autoinstall:
  version: 1

  locale: fr_FR.UTF-8
  keyboard:
    layout: fr

  identity:
    hostname: ubuntu-laptop
    username: ubuntu-admin
    password: "$6$/yanqE2Vz2S8vxoc$9AijXrulDxDWtdbzSRcFUGvQgoccp7jn3HYYx3l4n3MHeZZnrpgQuMuibotuTLc87L2/l0jTpEicShq5bvLOE0"

  ssh:
    install-server: true
    allow-pw: true

  # IMPORTANT: proxy doit être prêt avant packages.
  early-commands:
    - bash /cdrom/NOLOUD/prepare-proxy.sh || true

  packages:
    - btrfs-progs
    - cryptsetup
    - tpm2-tools
    - rsync
    - network-manager
    - network-manager-openconnect
    - iwd
    - btop
    - curl
    - git
    - wget
    - net-tools
    - ansible

  storage:
    config:
      # ---- DISK ----
      - type: disk
        id: disk0
        path: /dev/nvme0n1
        grub_device: true

      # ---- EFI ----
      - type: partition
        id: efi-part
        device: disk0
        size: 512M
        flag: boot

      - type: format
        id: efi-fs
        volume: efi-part
        fstype: fat32

      - type: mount
        id: mount-efi
        device: efi-fs
        path: /boot/efi

      # ---- SWAP (32G) chiffrée ----
      - type: partition
        id: swap-part
        device: disk0
        size: 32G

      - type: dm_crypt
        id: cryptswap
        dm_name: cryptswap
        volume: swap-part
        # clé aléatoire au boot (OK pour swap), on gère RESUME côté initramfs
        key: random

      - type: format
        id: swap-fs
        volume: cryptswap
        fstype: swap

      - type: mount
        id: mount-swap
        device: swap-fs
        path: none

      # ---- ROOT chiffrée ----
      - type: partition
        id: root-part
        device: disk0
        size: -1

      - type: dm_crypt
        id: cryptroot
        dm_name: cryptroot
        volume: root-part
        # on reste simple et robuste: passphrase demandée au boot, TPM enroll ensuite
        key: random

      - type: format
        id: root-btrfs
        volume: cryptroot
        fstype: btrfs

      # Montage final sur subvol=@ (créé en late-commands)
      - type: mount
        id: mount-root
        device: root-btrfs
        path: /
        options: "subvol=@,compress=zstd,noatime,ssd,space_cache=v2"

      - type: mount
        id: mount-home
        device: root-btrfs
        path: /home
        options: "subvol=@home,compress=zstd,noatime,ssd,space_cache=v2"

      - type: mount
        id: mount-var
        device: root-btrfs
        path: /var
        options: "subvol=@var,compress=zstd,noatime,ssd,space_cache=v2"

      - type: mount
        id: mount-snapshots
        device: root-btrfs
        path: /.snapshots
        options: "subvol=@snapshots,compress=zstd,noatime,ssd,space_cache=v2"

  late-commands:
    # Proxy nomade (172.30/172.31): activation/désactivation automatique sur le système installé
    - curtin in-target -- bash /cdrom/NOLOUD/install-proxy-autoswitch.sh || true

    # Créer les subvolumes btrfs AVANT que le système ne redémarre
    # On monte le "top-level" (subvolid=5), on crée @, @home, @var, @snapshots.
    - curtin in-target -- bash -lc '
        set -e
        mkdir -p /mnt/btrfs-top
        mount -o subvolid=5 /dev/mapper/cryptroot /mnt/btrfs-top
        btrfs subvolume create /mnt/btrfs-top/@
        btrfs subvolume create /mnt/btrfs-top/@home
        btrfs subvolume create /mnt/btrfs-top/@var
        btrfs subvolume create /mnt/btrfs-top/@snapshots
        umount /mnt/btrfs-top
      '

    # Hibernation: pointer le resume sur la swap chiffrée
    - curtin in-target -- bash -lc '
        set -e
        echo "RESUME=/dev/mapper/cryptswap" > /etc/initramfs-tools/conf.d/resume
        update-initramfs -u
      '

    # Recovery key root (ajoute une clé fichier en plus)
    - curtin in-target -- bash -lc '
        set -e
        install -d -m 0700 /root/recovery
        umask 077
        openssl rand -out /root/recovery/luks-root-recovery.key 32
        cryptsetup luksAddKey /dev/nvme0n1p3 /root/recovery/luks-root-recovery.key || true
      '

    # TPM auto-unlock root (best effort)
    - curtin in-target -- bash -lc '
        set -e
        apt-get update || true
        apt-get install -y tpm2-tools || true
        systemd-cryptenroll --tpm2-device=auto /dev/nvme0n1p3 || true
      '

    # NetworkManager + iwd backend
    - rm -f /target/etc/netplan/*.yaml
    - "echo 'network:\\n  version: 2\\n  renderer: NetworkManager' > /target/etc/netplan/01-nm.yaml"
    - chmod 600 /target/etc/netplan/01-nm.yaml

    - curtin in-target -- systemctl enable iwd
    - curtin in-target -- systemctl enable NetworkManager

    - mkdir -p /target/etc/NetworkManager/conf.d
    - "echo '[device]\\nwifi.backend=iwd' > /target/etc/NetworkManager/conf.d/wifi-backend.conf"

    - curtin in-target -- systemctl disable systemd-networkd || true
    - curtin in-target -- systemctl mask systemd-networkd || true
    - curtin in-target -- systemctl disable wpa_supplicant || true
    - curtin in-target -- systemctl mask wpa_supplicant || true
    