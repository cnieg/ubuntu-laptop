#cloud-config
autoinstall:
  version: 1

  locale: fr_FR.UTF-8
  keyboard:
    layout: fr

  identity:
    hostname: ubuntu-laptop
    username: ubuntu-admin
    password: "$6$/yanqE2Vz2S8vxoc$9AijXrulDxDWtdbzSRcFUGvQgoccp7jn3HYYx3l4n3MHeZZnrpgQuMuibotuTLc87L2/l0jTpEicShq5bvLOE0"

  ssh:
    install-server: true
    allow-pw: true

  storage:
    config:
      # Disque principal
      - type: disk
        id: disk0
        ptable: gpt
        wipe: superblock-recursive
        preserve: false
        grub_device: false

      # Partition EFI (512M)
      - type: partition
        id: part-efi
        device: disk0
        size: 512M
        number: 1
        flag: boot
        wipe: superblock-recursive
        preserve: false
        grub_device: true

      - type: format
        id: fmt-efi
        volume: part-efi
        fstype: fat32

      - type: mount
        id: mnt-efi
        device: fmt-efi
        path: /boot/efi

      # Partition /boot non chiffrée (1G, requis pour TPM)
      - type: partition
        id: part-boot
        device: disk0
        size: 1G
        number: 2
        wipe: superblock-recursive
        preserve: false
        grub_device: false

      - type: format
        id: fmt-boot
        volume: part-boot
        fstype: ext4

      - type: mount
        id: mnt-boot
        device: fmt-boot
        path: /boot

      # Partition chiffrée (reste du disque)
      - type: partition
        id: part-root
        device: disk0
        size: -1
        number: 3
        wipe: superblock-recursive
        preserve: false
        grub_device: false

      - type: dm_crypt
        id: cryptroot
        volume: part-root
        key: "LUKS-cnieg"

      - type: format
        id: fmt-root
        volume: cryptroot
        fstype: btrfs
        label: rootfs

      # Sous-volumes btrfs
      - type: btrfs_subvolume
        id: sv-root
        volume: fmt-root
        name: "@"

      - type: btrfs_subvolume
        id: sv-home
        volume: fmt-root
        name: "@home"

      # Montages avec sous-volumes
      - type: mount
        id: mnt-root
        device: fmt-root
        path: /
        options: subvol=@,compress=zstd

      - type: mount
        id: mnt-home
        device: fmt-root
        path: /home
        options: subvol=@home,compress=zstd

  late-commands:
    # Configuration TPM pour déverrouillage automatique
    - curtin in-target -- bash -c 'LUKS_DEV=$(blkid -t TYPE=crypto_LUKS -o device | head -n1); if [ -n "$LUKS_DEV" ] && [ -e /sys/class/tpm/tpm0 ]; then echo "Enrolling TPM"; systemd-cryptenroll --wipe-slot=tpm2 --tpm2-device=auto --tpm2-pcrs=0+7 "$LUKS_DEV" || true; else echo "No TPM detected, skipping enrollment"; fi'

    # Mettre à jour crypttab pour utiliser TPM
    - curtin in-target -- sed -i 's/luks,discard/luks,discard,tpm2-device=auto/' /etc/crypttab

    # Reconstruire initramfs avec support TPM
    - curtin in-target -- update-initramfs -u -k all

    # NetworkManager + iwd backend
    - rm -f /target/etc/netplan/*.yaml
    - "echo 'network:\\n  version: 2\\n  renderer: NetworkManager' > /target/etc/netplan/01-nm.yaml"
    - chmod 600 /target/etc/netplan/01-nm.yaml
    
    # Activer iwd et le configurer comme backend WiFi de NetworkManager
    - curtin in-target -- systemctl enable iwd
    - curtin in-target -- systemctl enable NetworkManager
    
    # Configurer NetworkManager pour utiliser iwd au lieu de wpa_supplicant
    - mkdir -p /target/etc/NetworkManager/conf.d
    - "echo '[device]\\nwifi.backend=iwd' > /target/etc/NetworkManager/conf.d/wifi-backend.conf"
    
    # Désactiver services réseau conflictuels
    - curtin in-target -- systemctl disable systemd-networkd
    - curtin in-target -- systemctl mask systemd-networkd
    - curtin in-target -- systemctl disable wpa_supplicant
    - curtin in-target -- systemctl mask wpa_supplicant

    # Trace d'installation
    - echo 'Install OK UEFI LUKS TPM btrfs NM iwd' > /target/root/install-complete.txt
    